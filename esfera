public class esfera extends figura_geometrica {

    private final double radio;

    public esfera(double radio) {

        this.radio = radio;
    }

    @Override
    public double calcularVolumen() {

        return (4 * Math.PI *
               Math.pow(radio, 3)) / 3;
    }

    @Override
    public double calcularSuperficie() {

        return 4 * Math.PI *
               Math.pow(radio, 2);
    }
}
