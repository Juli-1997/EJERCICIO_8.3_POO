import javax.swing.*;
import java.awt.event.*;

public class VentanaCilindro extends JFrame
implements ActionListener {

    private final JLabel lblRadio;
    private final JLabel lblAltura;

    private final JTextField txtRadio;
    private final JTextField txtAltura;

    private final JButton btnCalcular;
    private final JButton btnLimpiar;

    private final JLabel lblVolumen;
    private final JLabel lblSuperficie;

    public VentanaCilindro() {

        setTitle("Cilindro");

        setSize(400,350);

        setLayout(null);

        lblRadio = new JLabel("Radio:");

        lblRadio.setBounds(30,30,100,30);

        txtRadio = new JTextField();

        txtRadio.setBounds(120,30,150,30);

        lblAltura = new JLabel("Altura:");

        lblAltura.setBounds(30,80,100,30);

        txtAltura = new JTextField();

        txtAltura.setBounds(120,80,150,30);

        btnCalcular =
        new JButton("Calcular");

        btnCalcular.setBounds(30,140,120,30);

        btnLimpiar =
        new JButton("Limpiar");

        btnLimpiar.setBounds(170,140,120,30);

        lblVolumen =
        new JLabel("Volumen:");

        lblVolumen.setBounds(30,210,300,30);

        lblSuperficie =
        new JLabel("Superficie:");

        lblSuperficie.setBounds(30,250,300,30);

        add(lblRadio);
        add(txtRadio);

        add(lblAltura);
        add(txtAltura);

        add(btnCalcular);
        add(btnLimpiar);

        add(lblVolumen);
        add(lblSuperficie);

        btnCalcular.addActionListener(this);
        btnLimpiar.addActionListener(this);

        setLocationRelativeTo(null);
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        if(e.getSource() == btnCalcular){

            try{

                double radio =
                Double.parseDouble(
                txtRadio.getText());

                double altura =
                Double.parseDouble(
                txtAltura.getText());

                cilindro cilindro =
                new cilindro(radio, altura);

                lblVolumen.setText(
                "Volumen: " +
                cilindro.calcularVolumen());

                lblSuperficie.setText(
                "Superficie: " +
                cilindro.calcularSuperficie());

            }catch(Exception ex){

                JOptionPane.showMessageDialog(
                null,
                "Ingrese números válidos");
            }
        }

        if(e.getSource() == btnLimpiar){

            txtRadio.setText("");
            txtAltura.setText("");

            lblVolumen.setText("Volumen:");
            lblSuperficie.setText("Superficie:");
        }
    }
}
